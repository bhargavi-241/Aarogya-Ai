# ----------------------------------------------
# AarogyaAI Backend – Environment Variables
# Copy this file to .env and fill in your values
# ----------------------------------------------

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins (comma-separated, use * for local dev)
# Example for production: https://your-app.vercel.app
ALLOWED_ORIGINS=*

# SQLite DB path (optional, defaults to backend/ai_health.db)
DATABASE_URL=sqlite:///./ai_health.db
